# ---- GoHighLevel (required) -------------------------------------------------
# Private Integration Token, created at:
#   Sub-account -> Settings -> Private Integrations -> Create new integration
# Scopes needed: contacts.write, contacts.readonly, calendars/events.write, calendars.readonly
# This is a SUB-ACCOUNT token. Never put it in config.js or any client file.
GHL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sub-account id — Settings -> Business Profile, or the URL: /v2/location/<ID>/
GHL_LOCATION_ID=
# Calendar id — Settings -> Calendars -> the calendar -> copy id from the URL
GHL_CALENDAR_ID=
# Optional: the staff member the appointment is assigned to
GHL_ASSIGNED_USER_ID=

# One calendar per page. /face-neck falls back to the non-surgical calendar.
GHL_CALENDAR_ID_EYEBAGS=
GHL_CALENDAR_ID_LIFT=
GHL_CALENDAR_ID_NONSURGICAL=
# GHL_CALENDAR_ID_FACE_NECK=

# ---- Booking behaviour ------------------------------------------------------
BUSINESS_TZ=Europe/London
LEAD_SOURCE=Bye Bye Eye Bags LP
# true  = same as the original page: book regardless of what the calendar says.
# false = GHL rejects a slot someone already took, and the page says so.
# Default is true, to match the page you are replacing.
GHL_IGNORE_SLOT_VALIDATION=true
# /face-neck only. Set to false after /api/health?availability=1 shows the
# calendar's own hours match the page's start times.
# GHL_IGNORE_SLOT_VALIDATION_FACE_NECK=false

# Public base URL (metadata, CAPI fallbacks)
SITE_URL=https://lamoure-eyebag.vercel.app

# ---- GHL API versions (leave blank unless GHL changes something) -----------
# GHL_VERSION_CONTACTS=v3
# GHL_VERSION_CALENDARS=v3

# ---- Meta Conversions API (optional but recommended) -----------------------
# Server-side copy of the Schedule event, deduped against the browser pixel by
# event_id. Improves attribution when iOS/adblock kills the browser event.
META_PIXEL_ID=27589073474112473
META_CAPI_TOKEN=
# META_GRAPH_VERSION=v24.0
META_CURRENCY=GBP
# LEAD_VALUE=99
# Set while testing, then remove — Events Manager -> Test Events
# META_TEST_EVENT_CODE=
